{
  "name": "dsh-global-memory",
  "version": "0.1.1",
  "description": "DSH 全局记忆插件：在设置中提供「全局记忆」选项，直接查看/编辑 ~/.dsh/AGENTS.md 与 ~/.dsh/memory/*.md。Host 半边注册 /api/dsh-memory 路由（回环限制），client 半边通过 settings.section 槽位接入设置页。热插拔挂载，不改 DSH 源码。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "plugin"
  ],
  "author": "xujiping",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xujiping/dsh-plugins.git",
    "directory": "packages/dsh-global-memory"
  },
  "homepage": "https://github.com/xujiping/dsh-plugins/tree/main/packages/dsh-global-memory",
  "bugs": {
    "url": "https://github.com/xujiping/dsh-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
