{
  "name": "dsh-agent-driver",
  "version": "0.1.3",
  "description": "DSH 的原生智能体会话驱动：同一 UUID 绑定 DSH 与外部智能体 CLI 会话（当前支持 Claude Code，后续接入 Hermes、OpenClaw 等）。",
  "keywords": ["dsh", "agent-driver", "claude-code", "hermes", "openclaw", "native-session"],
  "author": "xujiping",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xujiping/dsh-plugins.git",
    "directory": "packages/dsh-agent-driver"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./remote": "./lib/remote.js",
    "./typert": "./lib/typert.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/commands.mjs && node test/permission-bridge.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-workspace": "^0.1.0-rc.6",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["connection", "remote", "sessions", "workspaces", "slots"],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.2 <0.2.0",
      "dshReleases": {
        "0.1.2-alpha.2": "unknown",
        "0.1.2-alpha.3": "unknown",
        "0.1.2-alpha.4": "unknown",
        "0.1.2-alpha.5": "unknown",
        "0.1.2-rc.1": "unknown",
        "0.1.3-alpha.2": "unknown",
        "0.1.5-alpha.1": "unknown",
        "0.1.5-alpha.2": "unknown",
        "0.1.5-rc.1": "unknown",
        "0.1.5-rc.2": "compatible",
        "0.1.5-rc.3": "unknown",
        "0.1.6-alpha.1": "unknown",
        "0.1.6-alpha.2": "unknown",
        "0.1.7-alpha.1": "unknown",
        "0.1.7-alpha.2": "unknown",
        "0.1.7-rc.1": "unknown",
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.1": "incompatible",
        "0.2.0-rc.2": "incompatible",
        "0.2.1-alpha.1": "incompatible"
      },
      "dshOperations": {
        "0.1.5-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed"
        },
        "0.1.7-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed"
        }
      }
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "CHANGELOG.md", "LICENSE"],
  "license": "MIT"
}
