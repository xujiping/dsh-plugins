{
  "name": "dsh-web-sites",
  "version": "0.4.2",
  "description": "DSH Web 集中管理自己的网站系统：侧边栏「新会话」下方注入「🌐 我的网站系统」菜单，点击展开站点列表，点击站点在主面板区域以 iframe 面板打开（刷新/新标签/管理/关闭）；打开网站时点左侧会话即收起面板。配置存 ~/.dsh/sites.yaml，支持界面增删改。纯 DOM 注入 + host 路由，不改 DSH 源码。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "web",
    "sites",
    "launcher",
    "iframe",
    "dashboard"
  ],
  "author": "xujiping",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xujiping/dsh-plugins.git",
    "directory": "packages/dsh-web-sites"
  },
  "homepage": "https://github.com/xujiping/dsh-plugins/tree/main/packages/dsh-web-sites",
  "bugs": {
    "url": "https://github.com/xujiping/dsh-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "compatibility": {
