{
  "name": "dsh-cc-agent-driver",
  "version": "0.1.0",
  "description": "DSH 的 Claude Code 原生会话驱动：同一 UUID 绑定 DSH 与 Claude Code 会话。",
  "keywords": ["dsh", "claude-code", "agent-driver", "native-session"],
  "author": "xujiping",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xujiping/dsh-plugins.git",
    "directory": "packages/dsh-cc-agent-driver"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./remote": "./lib/remote.js",
    "./typert": "./lib/typert.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-workspace": "^0.1.0-rc.6",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["connection", "remote", "sessions", "workspaces"],
      "platform": "web"
    }
  },
  "files": ["lib", "test", "cordis.patch.yml", "README.md", "CHANGELOG.md", "LICENSE"],
  "license": "MIT"
}
