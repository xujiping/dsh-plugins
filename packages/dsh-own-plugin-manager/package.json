{
  "name": "dsh-own-plugin-manager",
  "version": "0.5.1",
  "description": "DSH 自研插件管家：集中查看各 profile 已装插件（来源/版本/启停/自研标记），一键启停（行级 patch cordis.patch.yml，保留注释），关注 GitHub 插件仓库源浏览社区插件并一键安装，自动监测版本更新 —— npm registry、GitHub 仓库、GitHub release 包、link 本地源码（GitHub 远端最新版 + 本地漂移双信号）四类来源全覆盖，定时轮询 + 手动刷新，卡片式 UI 自有/社区双 Tab。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "plugin-manager",
    "version-check",
    "updater"
  ],
  "author": "xujiping",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xujiping/dsh-plugins.git",
    "directory": "packages/dsh-own-plugin-manager"
  },
  "homepage": "https://github.com/xujiping/dsh-plugins/tree/main/packages/dsh-own-plugin-manager",
  "bugs": {
    "url": "https://github.com/xujiping/dsh-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.2",
      "dshReleases": {
        "0.1.2-alpha.2": "unknown",
        "0.1.2-alpha.3": "unknown",
        "0.1.2-alpha.4": "unknown",
        "0.1.2-alpha.5": "unknown",
        "0.1.2-rc.1": "unknown",
        "0.1.3-alpha.2": "unknown",
        "0.1.5-alpha.1": "unknown",
        "0.1.5-alpha.2": "unknown",
        "0.1.5-rc.1": "unknown",
        "0.1.5-rc.2": "compatible",
        "0.1.5-rc.3": "unknown",
        "0.1.6-alpha.1": "unknown",
        "0.1.6-alpha.2": "unknown",
        "0.1.7-alpha.1": "unknown",
        "0.1.7-alpha.2": "unknown",
        "0.1.7-rc.1": "unknown",
        "0.1.7-rc.2": "unknown",
        "0.2.0-rc.1": "unknown",
        "0.2.0-rc.2": "unknown",
        "0.2.1-alpha.1": "unknown"
      },
      "dshOperations": {
        "0.1.5-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed"
        }
      }
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT"
}
