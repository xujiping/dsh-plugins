{
  "name": "dsh-own-plugin-manager",
  "version": "0.1.0",
  "description": "DSH 自研插件管家：集中查看各 profile 已装插件（来源/版本/启停/自研标记），一键启停（行级 patch cordis.patch.yml，保留注释），并自动监测版本更新 —— npm registry、GitHub 仓库、GitHub release 包、link 本地源码（版本+commit 快照对比）四类来源全覆盖，定时轮询 + 手动刷新，更新徽标一目了然。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "plugin-manager",
    "version-check",
    "updater"
  ],
  "author": "xujiping",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xujiping/dsh-plugins.git",
    "directory": "packages/dsh-own-plugin-manager"
  },
  "homepage": "https://github.com/xujiping/dsh-plugins/tree/main/packages/dsh-own-plugin-manager",
  "bugs": {
    "url": "https://github.com/xujiping/dsh-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT"
}
