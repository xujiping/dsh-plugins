{
  "name": "dsh-desktop-pet",
  "version": "0.3.2",
  "description": "DSH 桌面宠物：Web GUI 右下角一只纯 CSS 像素小宠，状态机驱动 idle/walk/sleep/happy/eat/typing/work 等动作；支持点击、拖拽、双击压缩上下文（把 /compact 注入官方输入框管线），并通过 MutationObserver 联动会话状态（AI 输出中 cheering、工具执行中 work、空闲自动睡觉）。纯 client DOM 注入，位置记忆到 localStorage，热插拔不改 DSH 源码。",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "pet",
    "desktop-pet",
    "animation",
    "sprite"
  ],
  "author": "xujiping",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xujiping/dsh-plugins.git",
    "directory": "packages/dsh-desktop-pet"
  },
  "homepage": "https://github.com/xujiping/dsh-plugins/tree/main/packages/dsh-desktop-pet",
  "bugs": {
    "url": "https://github.com/xujiping/dsh-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/dock.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["workspaces"],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.2",
      "dshReleases": {
        "0.1.2-alpha.2": "unknown",
        "0.1.2-alpha.3": "unknown",
        "0.1.2-alpha.4": "unknown",
        "0.1.2-alpha.5": "unknown",
        "0.1.2-rc.1": "unknown",
        "0.1.3-alpha.2": "unknown",
        "0.1.5-alpha.1": "unknown",
        "0.1.5-alpha.2": "unknown",
        "0.1.5-rc.1": "unknown",
        "0.1.5-rc.2": "compatible",
        "0.1.5-rc.3": "unknown",
        "0.1.6-alpha.1": "unknown",
        "0.1.6-alpha.2": "unknown",
        "0.1.7-alpha.1": "unknown",
        "0.1.7-alpha.2": "unknown",
        "0.1.7-rc.1": "unknown",
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "compatible"
      },
      "dshOperations": {
        "0.1.5-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed"
        },
        "0.1.7-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed"
        },
        "0.2.0-rc.1": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed"
        },
        "0.2.0-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed"
        },
        "0.2.1-alpha.1": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed"
        }
      }
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
